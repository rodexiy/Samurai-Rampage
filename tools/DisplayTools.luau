-- Paste into Studio's Command Bar in Edit mode.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Selection = game:GetService("Selection")

local Columns = 10
local Gap = 3
local Camera = workspace.CurrentCamera
local Origin = if Camera then Camera.Focus.Position + Vector3.new(0, 5, 0) else Vector3.new(0, 10, 0)
local FolderName = "ToolsDisplay"
local DisplayAttribute = "GeneratedToolsDisplay"

assert(not RunService:IsRunning(), "Run this script in Studio's Edit mode.")

local Existing = workspace:FindFirstChild(FolderName)
assert(not Existing or Existing:GetAttribute(DisplayAttribute), FolderName .. " already exists and was not generated by this script.")

local Templates = ReplicatedStorage.Assets:QueryDescendants("Tool") :: { Tool }
table.sort(Templates, function(First: Tool, Second: Tool): boolean
	return First:GetFullName() < Second:GetFullName()
end)
assert(#Templates > 0, "No tools were found in ReplicatedStorage.Assets.")

local function RemoveTags(Target: Instance)
	for _, Tag in Target:GetTags() do
		Target:RemoveTag(Tag)
	end

	for _, Child in Target:GetChildren() do
		RemoveTags(Child)
	end
end

local function PrepareDisplay(Template: Tool): Model?
	if not Template.Archivable or not Template:FindFirstChildWhichIsA("BasePart", true) then
		warn("Skipping tool without an archivable 3D model: " .. Template:GetFullName())
		return nil
	end

	local Tool = Template:Clone()
	Tool.Enabled = false
	Tool.CanBeDropped = false
	RemoveTags(Tool)

	for _, Script in Tool:QueryDescendants("BaseScript") :: { BaseScript } do
		Script.Enabled = false
	end

	for _, Part in Tool:QueryDescendants("BasePart") :: { BasePart } do
		Part.Anchored = true
		Part.CanCollide = false
		Part.CanTouch = false
	end

	local Display = Instance.new("Model")
	Display.Name = Template.Name
	Display:SetAttribute("SourcePath", Template:GetFullName())
	Tool.Parent = Display

	return Display
end

local Gallery = Instance.new("Folder")
Gallery.Name = FolderName
Gallery:SetAttribute(DisplayAttribute, true)

local Displays: { Model } = {}
local CellWidth, CellDepth = 0, 0
for _, Template in Templates do
	local Display = PrepareDisplay(Template)
	if Display then
		local _, Size = Display:GetBoundingBox()
		CellWidth = math.max(CellWidth, Size.X)
		CellDepth = math.max(CellDepth, Size.Z)
		Display.Parent = Gallery
		table.insert(Displays, Display)
	end
end
assert(#Displays > 0, "No tools could be cloned for display.")

for Index, Display in Displays do
	local Row = math.floor((Index - 1) / Columns)
	local Column = (Index - 1) % Columns
	local RowCount = math.min(Columns, #Displays - Row * Columns)
	local Bounds, Size = Display:GetBoundingBox()
	local Position = Origin + Vector3.new(
		(Column - (RowCount - 1) / 2) * (CellWidth + Gap),
		Size.Y / 2,
		Row * (CellDepth + Gap)
	)

	Display:PivotTo(CFrame.new(Position - Bounds.Position) * Display:GetPivot())
end

if Existing then
	Existing:Destroy()
end

Gallery.Parent = workspace
Selection:Set({ Gallery })
print(string.format("Displayed %d tools in %d rows (up to %d per row).", #Displays, math.ceil(#Displays / Columns), Columns))
