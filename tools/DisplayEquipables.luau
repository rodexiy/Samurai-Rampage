-- Run from Studio's Command Bar in Edit mode.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Selection = game:GetService("Selection")

local Columns = 10
local Gap = 3
local Camera = workspace.CurrentCamera
local Origin = if Camera then Camera.Focus.Position + Vector3.new(0, 5, 0) else Vector3.new(0, 10, 0)
local FolderName = "EquipablesDisplay"
local DisplayAttribute = "GeneratedEquipablesDisplay"

assert(not RunService:IsRunning(), "Run this script in Studio's Edit mode.")

local Existing = workspace:FindFirstChild(FolderName)
assert(not Existing or Existing:GetAttribute(DisplayAttribute), FolderName .. " already exists and was not generated by this script.")

local Templates: { Model } = {}
for _, Template in ReplicatedStorage.Assets.Equipables:QueryDescendants("Model") :: { Model } do
	-- Nested models belong to the same outfit; display the complete outfit once.
	if Template.Parent and Template.Parent:IsA("Folder") then
		table.insert(Templates, Template)
	end
end
table.sort(Templates, function(First: Model, Second: Model): boolean
	return First:GetFullName() < Second:GetFullName()
end)
assert(#Templates > 0, "No equipable models were found.")

local function RemoveTags(Target: Instance)
	for _, Tag in Target:GetTags() do
		Target:RemoveTag(Tag)
	end

	for _, Child in Target:GetChildren() do
		RemoveTags(Child)
	end
end

local function PrepareDisplay(Template: Model): Model?
	if not Template.Archivable then
		warn("Skipping non-archivable equipment: " .. Template:GetFullName())
		return nil
	end

	local Display = Template:Clone()
	if not Display:FindFirstChildWhichIsA("BasePart", true) then
		Display:Destroy()
		return nil
	end

	RemoveTags(Display)
	for _, Script in Display:QueryDescendants("BaseScript") :: { BaseScript } do
		Script.Enabled = false
	end

	for _, Part in Display:QueryDescendants("BasePart") :: { BasePart } do
		Part.Anchored = true
		Part.CanCollide = false
		Part.CanTouch = false
	end

	return Display
end

local Gallery = Instance.new("Folder")
Gallery.Name = FolderName
Gallery:SetAttribute(DisplayAttribute, true)

local Displays: { Model } = {}
local CellWidth, CellDepth = 0, 0
for _, Template in Templates do
	local Display = PrepareDisplay(Template)
	if Display then
		local _, Size = Display:GetBoundingBox()
		CellWidth = math.max(CellWidth, Size.X)
		CellDepth = math.max(CellDepth, Size.Z)
		Display.Parent = Gallery
		table.insert(Displays, Display)
	end
end
assert(#Displays > 0, "No equipment could be cloned for display.")

for Index, Display in Displays do
	local Row = math.floor((Index - 1) / Columns)
	local Column = (Index - 1) % Columns
	local RowCount = math.min(Columns, #Displays - Row * Columns)
	local Bounds, Size = Display:GetBoundingBox()
	local Position = Origin + Vector3.new(
		(Column - (RowCount - 1) / 2) * (CellWidth + Gap),
		Size.Y / 2,
		Row * (CellDepth + Gap)
	)

	Display:PivotTo(CFrame.new(Position - Bounds.Position) * Display:GetPivot())
end

if Existing then
	Existing:Destroy()
end

Gallery.Parent = workspace
Selection:Set({ Gallery })
print(string.format("Displayed %d equipables in %d rows (up to %d per row).", #Displays, math.ceil(#Displays / Columns), Columns))
