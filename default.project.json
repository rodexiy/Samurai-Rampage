{
  "name": "SHURA",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "UIS": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      },
      "Shared": {
        "$path": "src/ReplicatedStorage"
      }
    },
    "ReplicatedFirst": {
      "First": {
        "$path": "src/ReplicatedFirst"
      }
    },
    "ServerScriptService": {
      "Initializer": {
        "$path": "src/ServerScriptService"
      }
    },
    "ServerStorage": {
      "ServerAssets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "RealmTemplate": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,
          "MentalRealm": {
            "$path": "assets/terrain/MentalRealm.rbxm"
          }
        }
      },
      "Services": {
        "$path": "src/ServerStorage"
      }
    },
    "StarterGui": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ScreenOrientation": "LandscapeSensor",
        "VirtualCursorMode": "Enabled"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/StarterPlayer/StarterPlayerScripts"
        }
      },
      "StarterCharacterScripts": {
        "Client": {
          "$path": "src/StarterPlayer/StarterCharacterScripts"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      },
      "SoundServicePackage": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Combat": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,
          "Bow": {
            "$path": "src/SoundService/Bow.model.json"
          }
        }
      }
    }
  }
}